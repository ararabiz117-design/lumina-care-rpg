{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "react-jsx", "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "esModuleInterop": true, "types": ["vite/client", "@cloudflare/workers-types"]
  },
  "include": ["src", "app", "server", "vite.config.ts"]
}
